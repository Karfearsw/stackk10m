# ⚠️  TEMPLATE ONLY — DO NOT COMMIT REAL SECRETS HERE
# Copy this file to .env and replace placeholders with your real values.
# Never commit .env to git. Keep secrets local only.

DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:pass@host/db?sslmode=require"
SESSION_SECRET="replace-with-strong-secret"
EMPLOYEE_ACCESS_CODE="3911"
ADMIN_USERNAME="admin@example.com"
ADMIN_PASSWORD="replace-with-password"
PORT="3000"

# Telnyx
TELNYX_API_KEY="your-telnyx-api-key"
# Call Control Application ID (numeric) — NOT a SIP Credential Connection ID
TELNYX_CONNECTION_ID="your-connection-id"
TELNYX_MESSAGING_PROFILE_ID="your-messaging-profile-id"
TELNYX_PUBLIC_KEY="your-telnyx-public-key"
TELNYX_WEBHOOK_SIGNING_TOLERANCE_SECONDS="300"
TELNYX_WEBHOOK_URL="https://your-domain.com/api/v1/telecom/webhooks/telnyx"
TELNYX_DEFAULT_FROM_NUMBER="+1234567890"
DIALER_NUMBERS_JSON='["+1234567890"]'

# Telnyx Video (requires Video API access)
TELNYX_VIDEO_ENABLED=true
TELNYX_ROOM_ID=""

# Telnyx AI Assistant (High-Intent Lead Screener)
# Paste the Assistant ID from Telnyx portal > AI Assistants (a UUID).
# Transcripts arrive via ai_assistant.message_history_updated webhooks.
TELNYX_AI_ASSISTANT_ID=""
FEATURE_AI_ASSISTANT=false
ENABLE_TWO_LEG_CLICK_TO_DIAL=true
ENABLE_AI_SCREENING=true
ENABLE_AI_HUMAN_HANDOFF=true
TELNYX_AGENT_PHONE="" # optional fallback agent number (per-user setting in dialer wins)

# Email (Resend - primary provider)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM="notifications@yourdomain.com"

# Email (Telnyx - optional, requires beta access)
TELNYX_EMAIL_ENABLED=false
EMAIL_FROM_NAME="OceanLuxe CRM"
EMAIL_FROM_ADDRESS="notifications@yourdomain.com"

# Feature Flags
FEATURE_ESIGN=false
FEATURE_VIDEO_MEETINGS=true
FEATURE_PUBLIC_LISTINGS=false
FEATURE_RVM=false
FEATURE_SKIP_TRACE=false
FEATURE_CAMPAIGNS=false
FEATURE_FIELD_MODE=false
FEATURE_COMPS=false
FEATURE_BUYER_MATCH=false
FEATURE_VOICE_PLAYGROUND=false

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
DISCORD_WEBHOOK_CHANNEL_ID="your-channel-id"
DISCORD_WEBHOOK_NAME="Bot Name"
DISCORD_WEBHOOK_AVATAR_URL=""

# Document & media storage (see docs/storage-and-media.md)
# DOCUMENT_STORAGE_MODE: auto | database | object_storage | dual  (default: auto)
#   auto           -> S3 when DOCUMENTS_BUCKET+REGION set, otherwise Postgres
#   database       -> Postgres vault_document_blobs / media_blobs only
#   object_storage -> S3-compatible store only (fails if unconfigured)
#   dual           -> S3 primary + Postgres replica; reads fall back to DB
DOCUMENT_STORAGE_MODE=auto
DOCUMENTS_BUCKET=""            # e.g. crm-documents
DOCUMENTS_REGION=""            # e.g. us-east-1
DOCUMENTS_ENDPOINT=""          # optional: MinIO / R2 endpoint
DOCUMENTS_ACCESS_KEY_ID=""
DOCUMENTS_SECRET_ACCESS_KEY=""

# Media upload limits (bytes, or suffixed like "25mb" / "250mb")
MAX_IMAGE_UPLOAD_BYTES=25mb
MAX_VIDEO_UPLOAD_BYTES=250mb
MAX_MEDIA_UPLOAD_BYTES=250mb
MAX_MEDIA_ATTACHMENTS_PER_MESSAGE=10

# SMS/MMS: safe carrier threshold for MMS attachments (600 KB across US carriers)
MMS_SAFE_MEDIA_BYTES=614400

# Base URL used for short-lived media share links (MMS media_urls + secure links)
APP_BASE_URL="https://crm.oceanluxe.org"
